{
  "name": "songguessr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.admin.config.ts",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:catalog:playlist": "node scripts/build-catalog.mjs --playlist",
    "build:catalog:genre": "node scripts/build-catalog.mjs --genre",
    "build:catalog:watch": "node scripts/watch-catalog-build.mjs",
    "expand:catalog": "node scripts/build-catalog.mjs --expand",
    "expand:catalog:watch": "node scripts/watch-catalog-build.mjs --expand",
    "enrich:catalog": "node scripts/enrich-catalog.mjs",
    "upload:audio": "node scripts/upload-audio-to-r2.mjs",
    "upload:catalog": "node scripts/upload-catalog-to-r2.mjs",
    "seed:d1": "node scripts/seed-d1-from-r2.mjs",
    "sync:audio": "node scripts/sync-audio-to-r2.mjs",
    "audio:manifest": "node scripts/generate-audio-manifest.mjs",
    "audio:status": "node scripts/audio-status.mjs",
    "deploy": "npm run build && wrangler deploy",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-runde": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.5",
    "lottie-web": "^5.13.0",
    "lucide": "^1.39.0",
    "lucide-react": "^1.39.0",
    "morphicons": "^1.7.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
