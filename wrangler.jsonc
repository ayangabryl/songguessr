{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker + R2 bucket use songguessr branding. Old bucket songgussr can be retired after migration.
  "name": "songguessr",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "songguessr",
      // Local dev (`npm run dev`) reads the same remote R2 bucket as production.
      "remote": true
    }
  ],
  "workers_dev": true,
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  // Custom Domains (custom_domain: true) refused existing Namecheap URL-forward
  // A/CNAME records on this zone. Zone routes attach the Worker in front of those
  // records (already orange-clouded) without needing DNS write.
  "routes": [
    { "pattern": "songguessr.lol/*", "zone_name": "songguessr.lol" },
    { "pattern": "www.songguessr.lol/*", "zone_name": "songguessr.lol" }
  ],
  "vars": {
    "ADMIN_PASSWORD": "wizard123"
  }
}
