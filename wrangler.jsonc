{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name for branding. R2 bucket_name stays opm-songless-audio (existing Cloudflare resource).
  // If production was deployed as opm-songless, point your custom domain at this worker or redeploy.
  "name": "songgussr",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "opm-songless-audio"
    }
  ]
}
