{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker + R2 bucket use songgussr branding. Old bucket opm-songless-audio can be retired after migration.
  "name": "songgussr",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "songgussr",
      // Local dev (`npm run dev`) reads the same remote R2 bucket as production.
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "ADMIN_PASSWORD": "wizard123"
  }
}
